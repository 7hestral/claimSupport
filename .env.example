# Optional for the UI: you can enter a key in the sidebar instead.
# Required for command-line live evaluations. Never commit a real key.
OPENROUTER_API_KEY=
# Defaults to this model when unset. The model must support structured output.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Optional Langfuse tracing. Missing or blank connection values disable tracing, not chat.
# Set all three connection values to enable export.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TRACING_ENABLED=true
